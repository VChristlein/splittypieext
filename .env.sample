FIREBASE_APP_NAME=<YOUR-FIREBASE-APP-NAME>
FIREBASE_API_KEY=<YOUR-FIREBASE-API-KEY>
# Only needed if your Realtime Database uses the newer regional URL format
# (e.g. https://<project>-default-rtdb.<region>.firebasedatabase.app) instead of
# the legacy https://<FIREBASE_APP_NAME>.firebaseio.com
FIREBASE_DATABASE_URL=<YOUR-FIREBASE-DATABASE-URL>
GOOGLE_ANALYTICS_ID=<YOUR-GOOGLE-ANALYTICS-ID>
ROLLBAR_ACCESS_TOKEN=<YOUR-ROLLBAR-ACCESS-TOKEN>
ROLLBAR_SERVER_ACCESS_TOKEN=<YOUR-ROLLBAR-SERVER-ACCESS-TOKEN>
DEPLOY_SITE_URL=https://<your-site>
