<h4>{{t "settleUp.heading"}}</h4>

{{#if anyTransfers}}
  <div class="panel panel-default">
    <div class="panel-body">
      {{#each transfers as |transfer|}}
        <li class="settlement-item">
          <span class="settlement-statement">
            <strong>{{transfer.sender.name}}</strong> {{t "settleUp.owes"}} <strong>{{transfer.recipient.name}}</strong>
            <span class="text-nowrap">
              {{format-money-locale transfer.amount symbol=transfer.currency.code format="%v %s"}}
            </span>
          </span>
          <button class="btn btn-sm btn-success" {{action (action settleUp transfer)}}>
            {{t "settleUp.settleButton"}}
          </button>
        </li>
      {{/each}}
    </div>
  </div>
{{else}}
  <div class="alert alert-info" role="alert">
    {{t "settleUp.noneNeeded"}}
  </div>
{{/if}}