{{#mobile-toolbar}}
  {{back-button}}
  <span class="navbar-brand">{{title}}</span>
{{/mobile-toolbar}}

<h4 class="hidden-xs">{{title}}</h4>

<form>
  <div class="panel panel-default">
    <div class="panel-body">
      <div class="form-group">
        <label class="control-label">{{t "transferForm.whoSettled"}}</label>
        <div class="input-group">
          <p class="form-control-static transfer-sender">
            {{transfer.sender.name}}
          </p>
        </div>
      </div>

      <div class="form-group">
        <label class="control-label">{{t "transferForm.withWho"}}</label>
        <div class="input-group">
          <p class="form-control-static transfer-recipient">
            {{transfer.recipient.name}}
          </p>
        </div>
      </div>

      <div class="form-group">
        <label class="control-label">{{t "common.howMuch"}}</label>
        <div class="input-group">
          <span class="input-group-addon">{{transfer.event.currency.code}}</span>
          <p class="form-control-static transfer-amount">
            {{transfer.amount}}
          </p>
        </div>
      </div>

      <div class="form-group">
        <label class="control-label">{{t "transferForm.when"}}</label>
        <p class="form-control-static transfer-date">
          {{transfer.date}}
        </p>
      </div>

      {{#unless transfer.isNew}}
        <div class="form-group">
          <label class="control-label">{{t "common.otherOptions"}}</label>
          <div class="input-group">
            <button type="button" {{action "delete"}} class="btn btn-danger delete-transfer">{{t "transferForm.delete"}}</button>
          </div>
        </div>
      {{/unless}}
    </div>
  </div>

  <div class="form-group hidden-xs">
    {{#back-button}}
      {{t "common.cancel"}}
    {{/back-button}}
  </div>
</form>