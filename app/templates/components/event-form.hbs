{{#mobile-toolbar}}
  {{back-button}}
  <span class="navbar-brand">{{title}}</span>
  <button type="submit" {{action "save"}} disabled={{event.isSaving}} class="btn btn-link save-event navbar-btn">
    {{saveButtonText}}
  </button>
{{/mobile-toolbar}}

<h4 class="hidden-xs">{{title}}</h4>

<form>
  <div class="panel panel-default">
    <div class="panel-body">
      <div class="form-group {{if event.formErrors.name.messages "has-error"}}">
        <label class="control-label">{{t "eventForm.nameLabel"}}</label>
        {{input value=event.name class="form-control event-name" placeholder=(t "eventForm.namePlaceholder")}}
        <div class="help-block with-errors">
          {{event.formErrors.name.message}}
        </div>
      </div>
      <div class="form-group {{if event.formErrors.currency.message "has-error"}}">
        <label class="control-label">{{t "eventForm.currencyLabel"}}</label>
        {{my-select
          selectClass="event-currency"
          options=currencies
          selected=event.currency
          prompt=(t "eventForm.currencyPrompt")
          optionValuePath="code"
          optionLabelPath="nameWithCode"
        }}
        <div class="help-block with-errors">
          {{event.formErrors.currency.message}}
        </div>
      </div>
      <div class="form-group">
        <label class="control-label">{{t "eventForm.participantsLabel"}}</label>
        <p class="help-block">
          {{{t "eventForm.factorHelp"}}}
        </p>
        {{user-list users=event.users}}
        <button type="button" class="btn btn-primary add-user" {{action "addUser"}}>{{t "eventForm.addParticipant"}}</button>
      </div>

      {{#unless event.isNew}}
        <div class="form-group">
          <label class="control-label">{{t "common.otherOptions"}}</label>
          <div class="input-group">
            <button type="button" {{action "delete"}} class="btn btn-danger delete-event">{{t "eventForm.delete"}}</button>
            &nbsp;
            <button type="button" {{action "exportToExcel"}} class="btn btn-default export-excel">{{t "eventForm.exportExcel"}}</button>
            {{#if event.isOffline}}
              &nbsp;
              <button type="button" {{action "syncOnline"}} class="btn btn-success sync-online">{{t "eventForm.syncOnline"}}</button>
            {{/if}}
          </div>
        </div>
      {{/unless}}
    </div>
  </div>

  <div class="form-group hidden-xs">
    <button type="submit" {{action "save"}} disabled={{event.isSaving}} class="btn btn-success save-event">
      {{saveButtonText}}
    </button>
    {{t "common.or"}}
    {{#back-button}}
      {{t "common.cancel"}}
    {{/back-button}}
  </div>
</form>