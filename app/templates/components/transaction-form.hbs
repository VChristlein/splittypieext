{{#mobile-toolbar}}
  {{back-button}}
  <span class="navbar-brand">{{title}}</span>
  <button type="submit" {{action "save"}} disabled={{event.isSaving}} class="btn btn-link save-event navbar-btn">
    {{saveButtonText}}
  </button>
{{/mobile-toolbar}}

<h4 class="hidden-xs">{{title}}</h4>

<form>
  <div class="panel panel-default">
    <div class="panel-body">
      <div class="form-group">
        <label class="control-label">{{t "transactionForm.typeLabel"}}</label>
        {{my-select
          class="transaction-type"
          options=transactionTypes
          selected=transaction.selectedTransactionType
          optionValuePath="value"
          optionLabelPath="label"
        }}
      </div>

      <div class="form-group {{if transaction.formErrors.payer.message "has-error"}}">
        <label class="control-label">{{transaction.payerLabel}}</label>
        {{my-select
          class="transaction-payer"
          options=users
          selected=transaction.payer
          prompt=(t "transactionForm.selectPayerPrompt")
          optionValuePath="id"
          optionLabelPath="name"
        }}
        <div class="help-block with-errors">
          {{transaction.formErrors.payer.message}}
        </div>
      </div>

      <div class="form-group {{if transaction.formErrors.name.message "has-error"}}">
        <label class="control-label">{{t "transactionForm.nameLabel"}}</label>
        {{input value=transaction.name class="form-control transaction-name" placeholder=(t "transactionForm.namePlaceholder")}}
        <div class="help-block with-errors">
          {{transaction.formErrors.name.message}}
        </div>
      </div>

      {{#unless transaction.usesContributionEntries}}
        <div class="form-group {{if transaction.formErrors.amount.message "has-error"}}">
          <label class="control-label">{{t "common.howMuch"}}</label>
          <ul class="list-unstyled transaction-amounts">
            {{#each transaction.amountEntries as |entry|}}
              <li>
                <div class="input-group">
                  <span class="input-group-addon">{{transaction.event.currency.code}}</span>
                  {{input
                    value=entry.value
                    type="number"
                    step="0.01"
                    class="form-control transaction-amount"
                    placeholder=(t "transactionForm.amountPlaceholder")
                  }}
                  {{#if transaction.hasMultipleAmounts}}
                    <span class="input-group-btn">
                      <button
                          type="button"
                          class="btn btn-danger remove-amount"
                          {{action "removeAmount" entry}}
                          aria-label={{t "transactionForm.removeAmountAriaLabel"}}>
                        &times;
                      </button>
                    </span>
                  {{/if}}
                </div>
              </li>
            {{/each}}
          </ul>
          <button type="button" class="btn btn-default add-amount" {{action "addAmount"}}>
            {{t "transactionForm.addAnotherAmount"}}
          </button>
          {{#if transaction.hasMultipleAmounts}}
            <p class="help-block transaction-amount-total">
              {{t "common.total"}} {{format-money-locale transaction.amount symbol=transaction.event.currency.code format="%v %s"}}
            </p>
          {{/if}}
          <div class="help-block with-errors">
            {{transaction.formErrors.amount.message}}
          </div>
        </div>
      {{/unless}}

      <div class="form-group {{if transaction.formErrors.date.message "has-error"}}">
        <label class="control-label">{{t "transactionForm.dateLabel"}}</label>
        {{date-picker value=transaction.date className="transaction-date" min="2000-01-01" max=maxDate}}
        <div class="help-block with-errors">
          {{transaction.formErrors.date.message}}
        </div>
      </div>

      {{#if transaction.usesContributionEntries}}
        <div class="form-group">
          <label class="control-label">{{transaction.contributionsLabel}}</label>
          <ul class="list-unstyled transaction-contributions">
            {{#each transaction.contributionEntries as |entry|}}
              <li>
                <div class="input-group">
                  <span class="input-group-addon">{{entry.user.name}}</span>
                  <span class="input-group-addon">{{transaction.event.currency.code}}</span>
                  {{input type="number" step="0.01" min="0" class="contribution-amount" value=entry.amount}}
                </div>
              </li>
            {{/each}}
          </ul>
          <p class="help-block transaction-contributions-total">
            {{t "common.total"}} {{format-money-locale transaction.totalContributions symbol=transaction.event.currency.code format="%v %s"}}
          </p>
        </div>
      {{else}}
        <div class="form-group {{if transaction.formErrors.participants.message "has-error"}}">
          <label class="control-label">{{transaction.participantsLabel}}</label>
          {{my-checkbox-list
            class="transaction-participants"
            content=users
            selection=transaction.participants
            optionValuePath="id"
            optionLabelPath="name"
          }}
          <div class="help-block with-errors">
            {{transaction.formErrors.participants.message}}
          </div>

          <div class="checkbox">
            <label>
              {{input type="checkbox" class="transaction-obey-factors" checked=transaction.obeyFactors}}
              {{t "transactionForm.obeyFactors"}}
            </label>
          </div>

          {{#if transaction.obeyFactors}}
            <ul class="list-unstyled transaction-participant-factors">
              {{#each transaction.participantFactorEntries as |entry|}}
                <li>
                  <label>
                    {{entry.participant.name}}
                    {{input type="number" step="0.1" min="0" class="participant-factor" value=entry.factor}}
                  </label>
                </li>
              {{/each}}
            </ul>
          {{/if}}
        </div>
      {{/if}}

      {{#unless transaction.isNew}}
        <div class="form-group">
          <label class="control-label">{{t "common.otherOptions"}}</label>
          <div class="input-group">
            <button {{action "delete"}} class="btn btn-danger delete-transaction">{{t "transactionForm.delete"}}</button>
          </div>
        </div>
      {{/unless}}
    </div>
  </div>

  <div class="form-group hidden-xs">
    <button {{action "save"}} type="submit" disabled={{transaction.isSaving}} class="btn btn-success save-transaction">
      {{saveButtonText}}
    </button>
    {{t "common.or"}}
    {{#back-button}}
      {{t "common.cancel"}}
    {{/back-button}}
  </div>
</form>