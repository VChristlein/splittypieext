{{#if anyEvents}}
  <h3 class="text-center">{{t "previousEvents.heading"}}</h3>

  <div class="previous-events">
    {{#each events as |event|}}
      <div class="btn-group">
        {{#link-to "event.index" event.id class="btn btn-default"}}
          <strong>{{event.name}}</strong>
        {{/link-to}}
        <button {{action "remove" event}} class="btn btn-default" title={{t "previousEvents.removeTitle"}} aria-label={{t "previousEvents.removeAriaLabel"}}>
          {{inline-svg "close" class="icon"}}
        </button>
      </div>
    {{/each}}
  </div>
{{/if}}
