<form>
  {{#modal-dialog}}
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-hidden="true" aria-label={{t "common.dismiss"}}>&times;</button>
      <h4 class="modal-title">{{t "quickAdd.title"}}</h4>
    </div>
    <div class="modal-body pull-up-30">
      <div class="form-group {{if isFormInvalid "has-error"}}">
        {{input value=transactionToParse class="form-control transaction-parse" placeholder=(t "quickAdd.placeholder")}}
        <div class="help-block">
          {{t "quickAdd.examples"}}
        </div>
        <div>
          {{#if transaction}}
            {{transaction-list-item transaction=transaction}}
          {{/if}}
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-default pull-left btn-add-with-details" {{action "addWithDetails"}} data-dismiss="modal">{{t "quickAdd.addWithDetails"}}</button>
      <button type="submit" class="btn btn-primary btn-add" {{action "add"}} disabled={{isFormInvalid}}  data-dismiss="modal">{{t "quickAdd.add"}}</button>
    </div>
  {{/modal-dialog}}
</form>
