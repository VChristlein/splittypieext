{{#if transaction.date}}
  {{calendar-page date=transaction.date}}
{{/if}}
<div class="transaction-list-item-description">
  {{#if transaction.isTransfer}}
    <strong>{{transaction.payer.name}}</strong> {{t "transactionListItem.settledWith"}} <strong>{{transaction.participants.firstObject.name}}</strong>
  {{else if transaction.isDeposit}}
    {{t "transactionListItem.depositFor"}} <em>{{transaction.name}}</em>
    {{#if transaction.payer}}
      &mdash; {{t "transactionListItem.collectedBy"}} <strong>{{transaction.payer.name}}</strong>
    {{/if}}
    <br>
    {{inline-svg "user" class="icon"}} <small>{{contributors}}</small>
  {{else if transaction.isItemized}}
    <strong>{{transaction.payer.name}}</strong> {{t "transactionListItem.paidFor"}} <em>{{transaction.name}}</em><br>
    {{inline-svg "user" class="icon"}} <small>{{contributors}}</small>
  {{else}}
    <strong>{{transaction.payer.name}}</strong> {{verb}} <em>{{transaction.name}}</em><br>
    {{inline-svg "user" class="icon"}} <small>{{participants}}</small>
  {{/if}}
</div>
<div class="transaction-list-item-amount">
  <strong>
    {{format-money-locale transaction.amount symbol=transaction.event.currency.code format="%v %s"}}
  </strong>
  {{#if transaction.currency}}
    <br>
    <small class="text-muted transaction-original-amount">
      {{format-money-locale transaction.originalAmount symbol=transaction.currency.code format="%v %s"}}
    </small>
  {{/if}}
</div>