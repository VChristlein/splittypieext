{{#modal-dialog}}
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true" aria-label={{t "common.dismiss"}}>&times;</button>
    <h4 class="modal-title">{{t "common.confirmationTitle"}}</h4>
  </div>
  <div class="modal-body">
    {{t "common.areYouSure"}}
  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-primary" {{action "invokeAction" model.actions.ok}}>{{t "common.yes"}}</button>
    <button type="button" class="btn btn-default" data-dismiss="modal">{{t "common.no"}}</button>
  </div>
{{/modal-dialog}}