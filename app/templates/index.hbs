{{#mobile-toolbar}}
  {{side-menu-toggle-custom}}
  <span class="navbar-brand text-center">
    {{partial "shared/brand"}}
  </span>
{{/mobile-toolbar}}

{{#ember-wormhole to="navbar-right"}}
  <ul class="nav navbar-nav navbar-right">
    {{scroll-to href="#about" label=(t "index.aboutLabel")}}
    {{#if (any model.previousEvents)}}
      {{scroll-to href="#events" label=(t "index.eventsLabel")}}
    {{/if}}
    {{scroll-to href="#features" label=(t "index.featuresLabel")}}
    <li>
      <a href="https://github.com/cowbell/splittypie" target="_blank" rel="noopener" title={{t "common.sourceCodeTitle"}}>
        {{inline-svg "github" class="icon"}}
        {{t "index.source"}}
      </a>
    </li>
    {{#nav-link-to "new" title=(t "common.createNewEvent")}}
      {{inline-svg "plus" class="icon"}}
      {{t "common.newEvent"}}
    {{/nav-link-to}}
  </ul>
{{/ember-wormhole}}

<div class="index-sections">
  <section id="about">
    <div class="row main">
      <div class="col-sm-7 main-promotion-text">
        <h1>{{t "index.heroTitle"}}</h1>
        <p>
          {{{t "index.heroBody"}}}
        </p>
        <p>{{link-to (t "common.createNewEvent") "new" class="btn btn-lg btn-success"}}</p>
      </div>
      <div class="col-sm-5 main-promotion-image">
        <img src="/assets/app_iphone.png" alt={{t "index.heroImgAlt"}}>
      </div>
    </div>
  </section>

  {{#if (any model.previousEvents)}}
    {{previous-events events=model.previousEvents}}
  {{/if}}

  <section id="features">
    <h3 class="text-center">{{t "index.featuresHeading"}}</h3>

    <div class="row">
      <div class="col-md-4 text-center">
        <div class="feature-img-container">
          <img src="/assets/responsive.jpg" alt={{t "index.feature1ImgAlt"}}>
        </div>
        <h4>{{t "index.feature1Title"}}</h4>
        <p>
          {{t "index.feature1Body"}}
        </p>
      </div>
      <div class="col-md-4 text-center">
        <div class="feature-img-container">
          <img src="/assets/stopwatch.png" alt={{t "index.feature2ImgAlt"}}>
        </div>
        <h4>{{t "index.feature2Title"}}</h4>
        <p>
          {{t "index.feature2Body"}}
        </p>
      </div>
      <div class="col-md-4 text-center">
        <div class="feature-img-container">
          <img src="/assets/offline.png" alt={{t "index.feature3ImgAlt"}}>
        </div>
        <h4>{{t "index.feature3Title"}}</h4>
        <p>
          {{t "index.feature3Body"}}
        </p>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4 text-center">
        <div class="feature-img-container">
          <img src="/assets/free.png" alt={{t "index.feature4ImgAlt"}}>
        </div>
        <h4>{{t "index.feature4Title"}}</h4>
        <p>
          {{t "index.feature4Body"}}
        </p>
      </div>
      <div class="col-md-4 text-center">
        <div class="feature-img-container">
          <img src="/assets/share.png" alt={{t "index.feature5ImgAlt"}}>
        </div>
        <h4>{{t "index.feature5Title"}}</h4>
        <p>
          {{t "index.feature5Body"}}
        </p>
      </div>
      <div class="col-md-4 text-center">
        <div class="feature-img-container">
          <img src="/assets/open-source.png" alt={{t "index.feature6ImgAlt"}}>
        </div>
        <h4>{{t "index.feature6Title"}}</h4>
        <p>
          {{{t "index.feature6Body"}}}
        </p>
      </div>
    </div>
  </section>

  <div class="small-border"></div>

  <section class="social-list">
    <a href="https://github.com/cowbell/splittypie" target="_blank" rel="noopener" title={{t "common.sourceCodeTitle"}}>
      {{inline-svg "github" class="icon icon-md"}}
    </a>
    <a href="https://cowbell-labs.com" target="_blank" rel="noopener" title={{t "common.cowbellLabsTitle"}}>
      {{inline-svg "cowbell" class="icon icon-md cowbell"}}
    </a>
    <a href="https://facebook.com/splittypie" target="_blank" rel="noopener" title={{t "index.facebookTitle"}}>
      {{inline-svg "facebook" class="icon icon-md"}}
    </a>
    <a href="https://twitter.com/splittypie" target="_blank" rel="noopener" title={{t "index.twitterTitle"}}>
      {{inline-svg "twitter" class="icon icon-md"}}
    </a>
  </section>
</div>